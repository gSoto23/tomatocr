# Copiá este archivo a .env y completá los valores. Nunca subas .env al repositorio.

# Obligatoria. Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# "True" = SQLite local (sql_app.db). "False" = PostgreSQL con las variables DB_*.
# Ojo: si el servicio systemd define USE_SQLITE, ese valor gana sobre este archivo.
USE_SQLITE="True"

# PostgreSQL (solo cuando USE_SQLITE="False"). La conexión usa sslmode=require.
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=5432
DB_NAME=
# "require" en Lightsail. "disable" solo para un PostgreSQL local sin SSL.
DB_SSLMODE=require

# Correo (SMTP). Si la contraseña tiene espacios, ponela entre comillas.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=admin@tomatocr.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# S3 para fotos y archivos. Sin claves, se guardan en app/static/uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=tomato-prod-media-cr

# Prospectos: clave para que darboles.com envíe prospectos (servidor a servidor).
# Generá una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
DARBOLES_API_KEY=
LEADS_PER_IP_PER_HOUR=5
LEADS_PER_HOUR=30
LEADS_NOTIFY_EMAIL=info@tomatocr.com
